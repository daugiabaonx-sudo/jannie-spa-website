# =============================================================================
# JN Project — Local Docker Environment Example (.env.example)
# Copy this file to .env and replace placeholder values with generated secrets.
# =============================================================================

# --- Database Configuration (MariaDB LTS) ---
DB_NAME=jn_wordpress
DB_USER=jn_db_user
DB_PASSWORD=change_me_db_password
DB_ROOT_PASSWORD=change_me_db_root_password
DB_HOST=db
DB_CHARSET=utf8mb4
DB_COLLATE=
DB_TABLE_PREFIX=jn_8f4c_

# --- WordPress Environment & URLs ---
WP_ENVIRONMENT_TYPE=local
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080

# --- Install-Time Admin & Login Configuration ---
WP_ADMIN_USER=jn_director_xxxx
WP_ADMIN_PASSWORD=change_me_strong_admin_password
WP_ADMIN_EMAIL=admin@example.com
WP_LOGIN_SLUG=phong-lam-viec-7429

# --- Local Mail Catcher (Mailpit) ---
SMTP_HOST=mailpit
SMTP_PORT=1025

# --- WordPress Authentication Unique Keys and Salts ---
AUTH_KEY=change_me_unique_64_char_salt_1
SECURE_AUTH_KEY=change_me_unique_64_char_salt_2
LOGGED_IN_KEY=change_me_unique_64_char_salt_3
NONCE_KEY=change_me_unique_64_char_salt_4
AUTH_SALT=change_me_unique_64_char_salt_5
SECURE_AUTH_SALT=change_me_unique_64_char_salt_6
LOGGED_IN_SALT=change_me_unique_64_char_salt_7
NONCE_SALT=change_me_unique_64_char_salt_8
