# =============================================================================
# Jannie Nguyen Website — Production Environment Variables Template
# =============================================================================
# Copy to `/var/www/<PROD_DOMAIN>/.env.production` (chmod 0600, owned by root/php-fpm)
# and generate fresh cryptographic salts via `./deploy/generate-salts.sh`.
# NEVER commit the real `.env.production` file to Git.
# =============================================================================

WP_ENVIRONMENT_TYPE=production
WP_HOME=https://PROD_DOMAIN
WP_SITEURL=https://PROD_DOMAIN

# Database Credentials (MariaDB 11.4+ / MySQL 8.0+)
DB_NAME=jn_prod_db
DB_USER=jn_prod_user
DB_PASSWORD=REPLACE_WITH_STRONG_32_CHAR_DB_PASSWORD
DB_HOST=127.0.0.1
DB_CHARSET=utf8mb4
DB_COLLATE=
DB_TABLE_PREFIX=jn_8f4c_

# Security & Cron Flags
FORCE_SSL_ADMIN=true
DISABLE_WP_CRON=true

# Hidden login path (WPS Hide Login). Secret: choose a fresh random value per environment,
# hand it to administrators out of band, never commit it. Rotating = editing this line.
WP_LOGIN_SLUG=REPLACE_WITH_RANDOM_LOGIN_SLUG

# Fresh Cryptographic Salts (Run `./deploy/generate-salts.sh` and paste output below)
AUTH_KEY=REPLACE_WITH_FRESH_SALT_FROM_GENERATE_SALTS_SH
SECURE_AUTH_KEY=REPLACE_WITH_FRESH_SALT_FROM_GENERATE_SALTS_SH
LOGGED_IN_KEY=REPLACE_WITH_FRESH_SALT_FROM_GENERATE_SALTS_SH
NONCE_KEY=REPLACE_WITH_FRESH_SALT_FROM_GENERATE_SALTS_SH
AUTH_SALT=REPLACE_WITH_FRESH_SALT_FROM_GENERATE_SALTS_SH
SECURE_AUTH_SALT=REPLACE_WITH_FRESH_SALT_FROM_GENERATE_SALTS_SH
LOGGED_IN_SALT=REPLACE_WITH_FRESH_SALT_FROM_GENERATE_SALTS_SH
NONCE_SALT=REPLACE_WITH_FRESH_SALT_FROM_GENERATE_SALTS_SH
