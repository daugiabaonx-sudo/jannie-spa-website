{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "url": [
        "http://localhost:8080/",
        "http://localhost:8080/coaching/",
        "http://localhost:8080/my-story/",
        "http://localhost:8080/course/",
        "http://localhost:8080/client-success-story/",
        "http://localhost:8080/booking/",
        "http://localhost:8080/my-favorite-product/",
        "http://localhost:8080/san-pham/egf-cleansing-gel/",
        "http://localhost:8080/cart/",
        "http://localhost:8080/checkout/",
        "http://localhost:8080/tai-khoan/"
      ],
      "settings": {
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ],
        "chromeFlags": "--headless=new --no-sandbox --disable-gpu"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:8080/(?:|coaching/|my-story/|course/|client-success-story/|booking/)$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95,
                "aggregationMethod": "median"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median"
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median"
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median"
              }
            ],
            "first-contentful-paint": [
              "error",
              {
                "maxNumericValue": 1500,
                "aggregationMethod": "median"
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500,
                "aggregationMethod": "median"
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 100,
                "aggregationMethod": "median"
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.05,
                "aggregationMethod": "median"
              }
            ],
            "resource-summary:font:count": [
              "error",
              {
                "maxNumericValue": 3,
                "aggregationMethod": "median"
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 61440,
                "aggregationMethod": "median"
              }
            ],
            "resource-summary:stylesheet:size": [
              "error",
              {
                "maxNumericValue": 51200,
                "aggregationMethod": "median"
              }
            ],
            "resource-summary:third-party:count": [
              "error",
              {
                "maxNumericValue": 0,
                "aggregationMethod": "median"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:8080/(?:my-favorite-product/|san-pham/.*)$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median"
              }
            ],
            "categories:accessibility": [
              "error",
