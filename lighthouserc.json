              }
            ],
            "resource-summary:third-party:count": [
              "error",
              {
                "maxNumericValue": 0,
                "aggregationMethod": "median"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:8080/(?:cart/|checkout/|tai-khoan/)$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.85,
                "aggregationMethod": "median"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median"
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1,
                "aggregationMethod": "median"
              }
            ],
            "categories:seo": [
