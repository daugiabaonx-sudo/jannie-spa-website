                "aggregationMethod": "median"
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500,
                "aggregationMethod": "median"
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 100,
                "aggregationMethod": "median"
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.05,
                "aggregationMethod": "median"
              }
            ],
            "resource-summary:font:count": [
              "error",
              {
                "maxNumericValue": 3,
