# =============================================================================
# JN Project Whitelist .gitignore
# Strategy: Ignore everything by default (*), then explicitly unignore ONLY
# project-owned paths. WordPress core, third-party themes/plugins, uploads,
# caches, backups/, node_modules/, .env, and pre-existing workspace folders
# remain strictly untracked.
# =============================================================================

# 1. Ignore everything at workspace root by default
*

# 2. Track .gitignore and root-level Docker / test / lint config templates
!.gitignore
!docker-compose.yml
!docker-compose.*.yml
!.env.example
!phpcs.xml.dist
!phpunit.xml.dist
!playwright.config.js
!playwright.config.ts
!lighthouserc.js
!lighthouserc.json

# 3. Track Docker and Deployment Kit configuration directories
!docker/
!docker/**
!deploy/
!deploy/**

# 4. Track project scripts and automated test suites
!scripts/
!scripts/**
!tests/
!tests/**

# 5. Track project documentation (docs/jn/)
!docs/
docs/*
!docs/jn/
!docs/jn/**

# 6. Track ONLY .agent/rules/jn-project.md inside .agent/
!.agent/
.agent/*
!.agent/rules/
.agent/rules/*
!.agent/rules/jn-project.md

# 7. Track ONLY project-owned WordPress code inside ./wordpress/
#    (wp-config.php with no secrets, child theme blocksy-jn, custom plugin
#    jn-core, and the 2 MU-plugins). WordPress core files, third-party
#    plugins/themes, media uploads, and caches are strictly ignored.
!wordpress/
wordpress/*
!wordpress/.htaccess
!wordpress/wp-config.php
!wordpress/media/
wordpress/media/*
!wordpress/media/.htaccess
!wordpress/app/
wordpress/app/*
!wordpress/app/advanced-cache.php
!wordpress/app/wp-cache-config.php

# 7a. Child theme: wordpress/app/themes/jannie
!wordpress/app/themes/
wordpress/app/themes/*
!wordpress/app/themes/jannie/
!wordpress/app/themes/jannie/**

# 7b. Custom plugin: wordpress/app/modules/jn-core
!wordpress/app/modules/
wordpress/app/modules/*
!wordpress/app/modules/jn-core/
!wordpress/app/modules/jn-core/**

# 7c. Must-Use plugins: jn-hardening.php (+ jn-hardening/ modules) & jn-performance.php
!wordpress/app/mu-plugins/
wordpress/app/mu-plugins/*
!wordpress/app/mu-plugins/jn-hardening.php
!wordpress/app/mu-plugins/jn-hardening/
!wordpress/app/mu-plugins/jn-hardening/**
!wordpress/app/mu-plugins/jn-performance.php
!wordpress/app/mu-plugins/jn-performance/
!wordpress/app/mu-plugins/jn-performance/**

# 8. Always ignore OS, editor, dependency, secret, cache, and backup artifacts
**/.DS_Store
**/node_modules/
**/vendor/
**/.env
**/.env.local
**/.env.production
**/backups/
**/logs/
**/*.log
**/__pycache__/
**/*.pyc
